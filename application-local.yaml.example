# Скопируйте в application-local.yaml в корне проекта.

# --- Вариант 1: без Docker (H2, по умолчанию для локальной разработки) ---
spring:
  datasource:
    url: jdbc:h2:file:./data/channelpulse;MODE=PostgreSQL;AUTO_SERVER=TRUE
    username: sa
    password:
    driver-class-name: org.h2.Driver
  jpa:
    hibernate:
      ddl-auto: update
  flyway:
    enabled: false

# --- Вариант 2: с Docker (раскомментируйте, когда docker compose up -d работает) ---
# spring:
#   datasource:
#     url: jdbc:postgresql://localhost:5432/channelpulse
#     username: channelpulse
#     password: channelpulse
#   jpa:
#     hibernate:
#       ddl-auto: validate
#   flyway:
#     enabled: true

telegram:
  bot:
    token: "123456:ABC-DEF..."
    username: YourBotUsername
    enabled: true

pulse:
  ai:
    api-key: sk-your-proxyapi-key
  outreach:
    # true = реальная отправка ЛС через scout sidecar (нужен SENDER + sidecar-url)
    dispatch-enabled: true
    monthly-send-limit: 100
  scout:
    enabled: true
    sidecar-url: http://127.0.0.1:8090
    admin-telegram-ids: []   # ваш Telegram user id для Scout status
  admin:
    web-enabled: true
    web-token: pulse-local-admin   # http://127.0.0.1:8081/admin?token=...
  external:
    # Токен с https://api.tgstat.ru (тариф API Stat — для search/постов/статы).
    # Без token: анализ на скрейпе t.me (бесплатный слой).
    # tgstat-token: "YOUR_TGSTAT_TOKEN"
    tgstat-timeout-ms: 8000
    # true = TGStat только CONTENT+ при billing.enabled; локалка с billing=false — всегда ON
    tgstat-paid-only: true
