# Скопируйте в .env и заполните (https://my.telegram.org/apps)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Опционально: SOCKS5 прокси для всех сессий
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10808

SCOUT_SIDECAR_PORT=8090
SCOUT_ACCOUNTS_FILE=accounts.json
SCOUT_SESSIONS_DIR=sessions

# Архив ЛС: sidecar пушит текст/edit/delete в Java (тот же токен, что у админки)
PULSE_ARCHIVE_URL=http://127.0.0.1:8081/internal/scout-archive
PULSE_ARCHIVE_TOKEN=pulse-local-admin
